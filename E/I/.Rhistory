chic
chic <- read.csv("nmmaps-data2022_12_8D13_4_0.csv")
library(ggplot2)
library(dplyr)
# Load data
chic$date <- as.Date(chic$date)
# Plot
ggplot(chic, aes(x = temp, y = death)) +
# Layer 1: raw points, colored by pm10
geom_point(aes(color = pm10), alpha = 0.6, size = 2) +
# Layer 2: smooth trend line with confidence interval
geom_smooth(method = "lm", color = "firebrick", linewidth = 1, se = TRUE) +
# Layer 3: horizontal reference line (mean deaths)
geom_hline(yintercept = mean(chic$death),
linetype = "dashed", color = "gray40", linewidth = 0.7) +
# Layer 4: annotation for the reference line
annotate("text", x = max(chic$temp) - 2, y = mean(chic$death) + 2,
label = "Mean deaths", color = "gray40", size = 3, hjust = 1) +
# Layer 5: facet by season (only one here but code is generalizable)
facet_wrap(~ season) +
# Aesthetics
scale_color_viridis_c(option = "plasma", name = expression(PM[10]~(µg/m^3))) +
labs(
title = "Temperature vs. Daily Deaths in Chicago (1997)",
subtitle = "Points colored by PM10 concentration · Dashed line = mean daily deaths",
x = "Temperature (°F)",
y = "Daily Deaths",
caption = "Source: Chicago Air Pollution dataset"
) +
theme_bw(base_size = 12) +
theme(
plot.title    = element_text(face = "bold"),
plot.subtitle = element_text(color = "gray40"),
legend.position = "bottom",
strip.background = element_rect(fill = "gray90"),
strip.text = element_text(face = "bold")
)
# Plot
ggplot(chic, aes(x = temp, y = death)) +
geom_point(aes(color = pm10), alpha = 0.5) +
geom_smooth(method = "lm", color = "firebrick4") +
facet_grid(~ season) +
scale_color_viridis_c(option = "plasma", name = "PM10 (µg/m^3)") +
labs(
title = "Temperature vs. daily deaths in Chicago (1997)",
x = "Temperature (ºF)",
y = "Daily Deaths",
caption = "Source: NMMAPS dataset"
) +
theme_bw() +
theme(
legend.position = "bottom",
)
