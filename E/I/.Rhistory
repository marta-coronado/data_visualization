library(shiny)
library(ggplot2)
library(dplyr)
# ── Data ──────────────────────────────────────────────────────────────────────
# Read your CSV or paste the data directly:
chic <- read.csv("chicago.csv")
chic$date <- as.Date(chic$date)
# Variable choices for x-axis selector
x_choices <- c(
"Temperature (°F)"     = "temp",
"Dew Point"            = "dewpoint",
"PM10 (µg/m³)"         = "pm10",
"Ozone (ppb)"          = "o3"
)
# ── UI ────────────────────────────────────────────────────────────────────────
ui <- fluidPage(
titlePanel("🌬️ Chicago Air Quality & Mortality Explorer"),
sidebarLayout(
sidebarPanel(
# Widget 1: x-axis variable selector
selectInput(
inputId  = "xvar",
label    = "X-axis variable:",
choices  = x_choices,
selected = "temp"
),
# Widget 2: season filter (multiple allowed)
checkboxGroupInput(
inputId  = "seasons",
label    = "Filter by season:",
choices  = c("Winter", "Spring", "Summer", "Autumn"),
selected = c("Winter", "Spring", "Summer", "Autumn")
),
# Widget 3: toggle smooth line
checkboxInput(
inputId = "smooth",
label   = "Show trend line (lm)",
value   = TRUE
),
# Widget 4: toggle reference line
checkboxInput(
inputId = "refline",
label   = "Show mean deaths reference line",
value   = TRUE
),
hr(),
helpText("Data: Chicago Air Pollution dataset (1997–2000)")
),
mainPanel(
# Reactive plot
plotOutput("main_plot", height = "450px"),
hr(),
# Bonus: summary statistics table
h4("Summary statistics for selected variable (filtered data)"),
tableOutput("summary_table")
)
)
)
# ── Server ────────────────────────────────────────────────────────────────────
server <- function(input, output, session) {
# ── Reactive: filtered data ────────────────────────────────────────────────
filtered_data <- reactive({
# Filter by selected seasons; show nothing if none selected
req(input$seasons)
chic %>% filter(season %in% input$seasons)
})
# ── Output 1: scatter plot ─────────────────────────────────────────────────
output$main_plot <- renderPlot({
df   <- filtered_data()
xvar <- input$xvar
# Base plot: points colored by season
p <- ggplot(df, aes(x = .data[[xvar]], y = death, color = season)) +
geom_point(alpha = 0.6, size = 2) +
scale_color_brewer(palette = "Set1", name = "Season") +
labs(
title   = paste("Daily Deaths vs.", names(x_choices)[x_choices == xvar]),
subtitle = paste("Seasons shown:", paste(input$seasons, collapse = ", ")),
x       = names(x_choices)[x_choices == xvar],
y       = "Daily Deaths",
caption = "Source: Chicago Air Pollution dataset"
) +
theme_bw(base_size = 13) +
theme(
plot.title    = element_text(face = "bold"),
plot.subtitle = element_text(color = "gray40"),
legend.position = "bottom"
)
# Optional: linear trend line per season
if (input$smooth) {
p <- p + geom_smooth(method = "lm", se = TRUE, linewidth = 0.8)
}
# Optional: horizontal reference line (mean deaths in filtered data)
if (input$refline) {
mean_death <- mean(df$death, na.rm = TRUE)
p <- p +
geom_hline(yintercept = mean_death,
linetype = "dashed", color = "gray30", linewidth = 0.7) +
annotate("text",
x     = max(df[[xvar]], na.rm = TRUE),
y     = mean_death + 1.5,
label = paste0("Mean: ", round(mean_death, 1)),
hjust = 1, color = "gray30", size = 3.5)
}
p
})
# ── Output 2: summary statistics table (BONUS) ─────────────────────────────
output$summary_table <- renderTable({
df   <- filtered_data()
xvar <- input$xvar
df %>%
group_by(season) %>%
summarise(
N    = n(),
Mean = round(mean(.data[[xvar]], na.rm = TRUE), 2),
SD   = round(sd(.data[[xvar]],   na.rm = TRUE), 2),
Min  = round(min(.data[[xvar]],  na.rm = TRUE), 2),
Max  = round(max(.data[[xvar]],  na.rm = TRUE), 2),
.groups = "drop"
) %>%
rename(Season = season)
})
}
# ── Launch ────────────────────────────────────────────────────────────────────
shinyApp(ui = ui, server = server)
View(chic)
head(chic)
runApp('chic_shiny_app.R')
